---
interface Props { items: { q: string; a: string }[]; heading?: string; id?: string }
const { items, heading = 'Questions', id = 'faq' } = Astro.props;
---
<section class="faq" aria-labelledby={`${id}-h`}>
  <h2 id={`${id}-h`} class="faq__h">{heading}</h2>
  <div class="faq__list">
    {items.map((it, i) => (
      <details open={i === 0}>
        <summary><span class="faq__n mono">{String(i + 1).padStart(2, '0')}</span><h3>{it.q}</h3></summary>
        <p>{it.a}</p>
      </details>
    ))}
  </div>
</section>
<style>
  .faq { display: grid; grid-template-columns: 1fr 2fr; gap: 48px; }
  .faq__h { position: sticky; top: 100px; align-self: start; }
  .faq__list { border-top: 1px solid var(--rule); }
  details { border-bottom: 1px solid var(--rule); }
  summary { list-style: none; display: grid; grid-template-columns: 44px 1fr 20px; gap: 12px; align-items: baseline; padding: 22px 0; cursor: pointer; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '+'; font: 400 1.4rem/1 var(--mono); color: var(--amber); justify-self: end; transition: transform .2s; }
  details[open] summary::after { transform: rotate(45deg); }
  summary h3 { font-family: var(--body); text-transform: none; font-weight: 500; font-size: 1.12rem; letter-spacing: 0; line-height: 1.35; }
  summary:hover h3 { color: var(--amber); }
  .faq__n { font-size: .75rem; color: var(--steel); }
  details p { padding: 0 0 24px 56px; color: var(--steel); }
  @media (max-width: 860px) { .faq { grid-template-columns: 1fr; gap: 24px; } .faq__h { position: static; } details p { padding-left: 0; } }
</style>
