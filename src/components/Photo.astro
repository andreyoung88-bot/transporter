---
import { photos, type PhotoKey } from '../data/photos';
interface Props {
  name: PhotoKey;
  /** Display ratio, width / height. Crops via the image CDN. */
  ratio?: number;
  sizes?: string;
  eager?: boolean;
  class?: string;
}
const { name, ratio = 3 / 2, sizes = '100vw', eager = false, class: className } = Astro.props;
const p = photos[name];
const widths = [480, 800, 1200, 1600];
const url = (w: number) => `https://images.unsplash.com/${p.src}?auto=format&fit=crop&crop=entropy&q=70&w=${w}&h=${Math.round(w / ratio)}`;
const srcset = widths.map((w) => `${url(w)} ${w}w`).join(', ');
---
<img
  class:list={['photo', className]}
  src={url(800)}
  srcset={srcset}
  sizes={sizes}
  width={800}
  height={Math.round(800 / ratio)}
  alt={p.alt}
  loading={eager ? 'eager' : 'lazy'}
  fetchpriority={eager ? 'high' : undefined}
  decoding="async"
/>
<style>
  .photo { display: block; width: 100%; height: auto; background: var(--gunmetal); filter: grayscale(.35) contrast(1.05) brightness(.9); }
</style>
